// Single authoritative schema + migration workflow for the whole platform (Prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  STUDENT
  GRADUATE
  JOB_SEEKER
  ENTREPRENEUR
  PROFESSIONAL
  GOVERNMENT_ANALYST
  ADMINISTRATOR
}

enum EducationLevel {
  NONE
  PRIMARY
  LOWER_SECONDARY
  UPPER_SECONDARY
  TVET_CERTIFICATE
  DIPLOMA
  BACHELORS
  MASTERS
  DOCTORATE
}

enum GoalCategory {
  EDUCATION
  CAREER
  ENTREPRENEURSHIP
  SKILLS
  INCOME
  STUDY_ABROAD
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum StepStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

enum StepKind {
  EDUCATION
  SKILL
  EXPERIENCE
  APPLY
  MILESTONE
}

enum RefType {
  PROGRAM
  OPPORTUNITY
  SKILL
  OCCUPATION
}

enum OpportunityType {
  SCHOLARSHIP
  INTERNSHIP
  JOB
  TRAINING
  FELLOWSHIP
  GRANT
}

enum DemandLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
  UNKNOWN
}

enum InstitutionType {
  UNIVERSITY
  POLYTECHNIC
  TVET
  ACADEMY
  OTHER
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum PathType {
  LEARNING_PATH
  CAREER_ROADMAP
}

enum UsageKind {
  AI_REQUEST
  RECOMMENDATION
  ROADMAP
  CHAT
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ApplicationStatus {
  DISCOVERED
  ELIGIBLE
  INELIGIBLE
  DOCUMENTS_REQUIRED
  PREPARING
  READY_FOR_REVIEW
  APPROVED
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  ARCHIVED
}

enum ApplicantDocumentStatus {
  UPLOADED
  PROCESSING
  AWAITING_CONFIRMATION
  VERIFIED
  REJECTED
}

// ─────────────────────── Identity & access ───────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          Role     @default(STUDENT)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       Profile?
  goals         Goal[]
  refreshTokens RefreshToken[]
  oneTimeTokens OneTimeToken[]
  chatMessages  ChatMessage[]
  applications ApplicantApplication[]
  applicantDetails ApplicantProfile?
  applicantDocuments ApplicantDocument[]
  ventureProjects    VentureProject[]
  ventureMemberships VentureMember[]

  @@index([role])
}

/// Opaque refresh tokens, stored hashed, rotated on every use. `familyId` lets us revoke a whole
/// chain when a rotated token is replayed (token theft detection).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Single-use e-mail verification and password-reset tokens (hash only, never the raw token).
model OneTimeToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  targetId  String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

// ───────────────────── Provenance & national data ─────────────────────

/// Every reference record points to its source. `isDemo` marks illustrative records so they can
/// never be mistaken for official statistics.
model DataSource {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  publisher   String
  url         String?
  license     String?
  publishedAt DateTime?
  retrievedAt DateTime
  notes       String?
  isDemo      Boolean   @default(false)

  districtStats   DistrictStat[]
  indicatorValues IndicatorValue[]
  occupations     Occupation[]
  institutions    Institution[]
  programs        Program[]
  opportunities   Opportunity[]
  careerPaths     CareerPath[]
}

model Province {
  id        String     @id @default(cuid())
  name      String     @unique
  districts District[]
}

model District {
  id         String @id @default(cuid())
  name       String @unique
  provinceId String

  province Province       @relation(fields: [provinceId], references: [id])
  stats    DistrictStat[]
  profiles Profile[]
  institutions Institution[]
  ventureProjects VentureProject[]

  @@index([provinceId])
}

model DistrictStat {
  id              String @id @default(cuid())
  districtId      String
  year            Int
  population      Int
  urbanPopulation Int
  sourceId        String

  district District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  source   DataSource @relation(fields: [sourceId], references: [id])

  @@unique([districtId, year, sourceId])
}

model Indicator {
  id     String @id @default(cuid())
  code   String @unique
  name   String
  unit   String

  values IndicatorValue[]
}

model IndicatorValue {
  id          String @id @default(cuid())
  indicatorId String
  period      String
  geography   String @default("Rwanda")
  value       Float
  sourceId    String

  indicator Indicator  @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  source    DataSource @relation(fields: [sourceId], references: [id])

  @@unique([indicatorId, period, geography])
}

// ───────────────────────── Skills, sectors, occupations ─────────────────────────

model Sector {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  nst2Priority Boolean @default(false)

  occupations Occupation[]
  programs    Program[]
  interests   ProfileSector[]
  careerPaths CareerPath[]
  ventureProjects VentureProject[]
}

model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?

  occupationSkills OccupationSkill[]
  programSkills    ProgramSkill[]
  profileSkills    ProfileSkill[]

  @@index([category])
}

model Occupation {
  id           String         @id @default(cuid())
  title        String         @unique
  description  String?
  sectorId     String
  minEducation EducationLevel @default(UPPER_SECONDARY)
  demand       DemandLevel    @default(UNKNOWN)
  /// Salary fields stay NULL unless a verified figure exists. They are never estimated by the platform.
  salaryMinRwf Int?
  salaryMaxRwf Int?
  sourceId     String?

  sector Sector      @relation(fields: [sectorId], references: [id])
  source DataSource? @relation(fields: [sourceId], references: [id])
  skills OccupationSkill[]
  programs ProgramOccupation[]
  goals  Goal[]
  careerPaths CareerPath[]

  @@index([sectorId])
  @@index([demand])
}

model OccupationSkill {
  occupationId  String
  skillId       String
  importance    Int    @default(3) // 1-5
  requiredLevel Int    @default(3) // 1-5

  occupation Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([occupationId, skillId])
}

// ───────────────────────── Education supply ─────────────────────────

model Institution {
  id         String          @id @default(cuid())
  name       String          @unique
  type       InstitutionType
  districtId String?
  website    String?
  sourceId   String

  district District?  @relation(fields: [districtId], references: [id])
  source   DataSource @relation(fields: [sourceId], references: [id])
  programs Program[]

  @@index([districtId])
}

model Program {
  id             String         @id @default(cuid())
  institutionId  String
  name           String
  level          EducationLevel
  durationMonths Int?
  url            String?
  sectorId       String?
  sourceId       String

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sector      Sector?     @relation(fields: [sectorId], references: [id])
  source      DataSource  @relation(fields: [sourceId], references: [id])
  skills      ProgramSkill[]
  occupations ProgramOccupation[]

  @@unique([institutionId, name])
  @@index([level])
}

model ProgramSkill {
  programId String
  skillId   String

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([programId, skillId])
}

model ProgramOccupation {
  programId    String
  occupationId String

  program    Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  occupation Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  @@id([programId, occupationId])
}

model Opportunity {
  id             String          @id @default(cuid())
  type           OpportunityType
  title          String
  provider       String
  description    String?
  eligibility    String?
  minEducation   EducationLevel?
  deadline       DateTime?
  isRolling      Boolean         @default(false)
  country        String?
  url            String?
  lastVerifiedAt DateTime?
  sourceId       String

  source DataSource @relation(fields: [sourceId], references: [id])
  applications ApplicantApplication[]
  requirements OpportunityRequirement[]

  @@unique([provider, title])
  @@index([type])
  @@index([deadline])
}

/// Reference templates: either a skills learning path or an end-to-end career roadmap for an occupation.
model CareerPath {
  id             String          @id @default(cuid())
  slug           String          @unique
  type           PathType
  title          String
  summary        String
  occupationId   String?
  sectorId       String?
  startLevel     EducationLevel?
  durationMonths Int?
  sourceId       String

  occupation Occupation? @relation(fields: [occupationId], references: [id], onDelete: SetNull)
  sector     Sector?     @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  source     DataSource  @relation(fields: [sourceId], references: [id])
  steps      CareerPathStep[]

  @@index([type])
  @@index([occupationId])
}

model CareerPathStep {
  id            String   @id @default(cuid())
  pathId        String
  order         Int
  phase         String
  title         String
  description   String
  kind          StepKind
  monthOffset   Int      @default(0)
  resourceLabel String?
  resourceUrl   String?

  path CareerPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, order])
}

// ───────────────────────── Monitoring & conversation ─────────────────────────

/// Anonymous operational telemetry (no user id, no content) powering the admin monitoring dashboard.
model UsageEvent {
  id        String    @id @default(cuid())
  kind      UsageKind
  feature   String?
  provider  String?
  success   Boolean   @default(true)
  latencyMs Int?
  errorCode String?
  createdAt DateTime  @default(now())

  @@index([kind, createdAt])
  @@index([provider, createdAt])
}

/// Saved HDOS assistant conversation, owned by the user and deleted with the account.
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      ChatRole
  content   String
  provider  String?
  goalId    String?
  /// HDOS AI operating mode that produced/handled the turn (null for legacy messages).
  mode      String?
  /// Venture workspace the turn was about; no foreign key so chat history survives venture deletion.
  ventureId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Applicant-owned tracking record. Submission is always recorded explicitly; no unattended submissions.
model ApplicantApplication {
  id String @id @default(cuid())
  userId String
  opportunityId String
  status ApplicationStatus @default(DISCOVERED)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receiptReference String?
  submittedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  answers ApplicationAnswer[]
  events ApplicationEvent[]
  documents ApplicationDocument[]
  @@unique([userId, opportunityId])
  @@index([userId, status])
}

model ApplicantProfile {
  id String @id @default(cuid())
  userId String @unique
  phone String?
  country String @default("RW")
  location String?
  education Json @default("[]")
  experience Json @default("[]")
  skills Json @default("[]")
  languages Json @default("[]")
  preferences Json @default("{}")
  confirmedAt DateTime?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// File bytes are encrypted before persistence; storageKey remains for filesystem compatibility.
model ApplicantDocument {
  id String @id @default(cuid())
  userId String
  kind String
  groupId String
  version Int @default(1)
  status ApplicantDocumentStatus @default(UPLOADED)
  expiresAt DateTime?
  fileName String
  mimeType String
  sizeBytes Int
  sha256 String
  storageKey String @unique
  encryptedBytes Bytes?
  extractedText Json?
  extractionConfirmedAt DateTime?
  retentionUntil DateTime?
  archivedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentVersions ApplicantDocumentVersion[]
  extractions DocumentExtraction[]
  verifications DocumentVerification[]
  accesses DocumentAccessLog[]
  applicationSnapshots ApplicationDocument[]
  ventureLinks VentureDocumentLink[]
  @@index([userId, kind])
  @@index([userId, groupId, version])
}

model ApplicantDocumentVersion {
  id String @id @default(cuid())
  documentId String
  version Int
  storageKey String @unique
  encryptedBytes Bytes?
  sha256 String
  fileName String
  sizeBytes Int
  mimeType String
  createdAt DateTime @default(now())
  document ApplicantDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, version])
}

model DocumentExtraction {
  id String @id @default(cuid())
  documentId String
  source String
  extractedData Json
  extractedAt DateTime @default(now())
  confirmedAt DateTime?
  document ApplicantDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@index([documentId, extractedAt])
}

model DocumentVerification {
  id String @id @default(cuid())
  documentId String
  reviewerId String
  status ApplicantDocumentStatus
  reason String?
  createdAt DateTime @default(now())
  document ApplicantDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@index([documentId, createdAt])
}

model DocumentAccessLog {
  id String @id @default(cuid())
  documentId String
  userId String
  action String
  createdAt DateTime @default(now())
  document ApplicantDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@index([documentId, createdAt])
}

model DocumentRetentionPolicy {
  id String @id @default(cuid())
  country String
  category String
  retentionDays Int
  active Boolean @default(true)
  @@unique([country, category])
}

model OpportunityRequirement {
  id String @id @default(cuid())
  opportunityId String
  version Int @default(1)
  key String
  description String
  kind String
  mandatory Boolean @default(true)
  minimumCount Int @default(1)
  acceptedEvidence Json @default("[]")
  sourceUrl String?
  country String?
  effectiveFrom DateTime?
  effectiveUntil DateTime?
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([opportunityId, version, key])
  @@index([opportunityId, mandatory])
}

model ApplicationAnswer {
  id String @id @default(cuid())
  applicationId String
  questionKey String
  answer String
  confirmedAt DateTime?
  application ApplicantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([applicationId, questionKey])
}

model ApplicationEvent {
  id String @id @default(cuid())
  applicationId String
  status ApplicationStatus
  detail String?
  createdAt DateTime @default(now())
  application ApplicantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, createdAt])
}

model ApplicationDocument {
  id String @id @default(cuid())
  applicationId String
  documentId String
  snapshotStorageKey String
  sha256 String
  version Int @default(1)
  opportunityRequirementsVersion Int?
  createdAt DateTime @default(now())
  application ApplicantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document ApplicantDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  @@unique([applicationId, documentId])
}

model CountryConfiguration {
  code String @id
  name String
  languages Json @default("[]")
  privacyNoticeUrl String?
  storageRegion String?
  requirements Json @default("{}")
  updatedAt DateTime @updatedAt
}

model InstitutionConnector {
  id String @id @default(cuid())
  name String
  country String
  kind String
  endpoint String
  enabled Boolean @default(false)
  authorizationReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([country, enabled])
}

// ───────────────────────── Users' development data ─────────────────────────

model Profile {
  id                     String         @id @default(cuid())
  userId                 String         @unique
  educationLevel         EducationLevel @default(NONE)
  districtId             String?
  birthYear              Int?
  bio                    String?
  avatarData             String?        @db.Text
  targetMonthlyIncomeRwf Int?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  district  District?       @relation(fields: [districtId], references: [id])
  skills    ProfileSkill[]
  interests ProfileSector[]
}

model ProfileSkill {
  profileId String
  skillId   String
  level     Int    @default(1) // 1-5

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
}

model ProfileSector {
  profileId String
  sectorId  String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sector  Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([profileId, sectorId])
}

model Goal {
  id                 String       @id @default(cuid())
  userId             String
  title              String
  description        String?
  category           GoalCategory
  status             GoalStatus   @default(ACTIVE)
  targetDate         DateTime?
  targetOccupationId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetOccupation Occupation? @relation(fields: [targetOccupationId], references: [id], onDelete: SetNull)
  roadmap          Roadmap?

  @@index([userId, status])
}

model Roadmap {
  id            String   @id @default(cuid())
  goalId        String   @unique
  summary       String
  engineVersion String
  generatedAt   DateTime @default(now())

  goal  Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  steps RoadmapStep[]
}

model RoadmapStep {
  id          String     @id @default(cuid())
  roadmapId   String
  order       Int
  phase       String
  title       String
  description String
  kind        StepKind
  monthOffset Int        @default(0)
  status      StepStatus @default(TODO)
  refType     RefType?
  refId       String?
  refLabel    String?
  updatedAt   DateTime   @updatedAt

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, order])
}

// ═══════════════════════════ HDOS Venture Builder ═══════════════════════════
// Venture workspace domain (see docs/VENTURE_BUILDER.md). Reuses User, Sector, District, Opportunity and the
// document vault (ApplicantDocument) instead of duplicating them. Every child row is isolated by projectId.

enum VentureStatus {
  DRAFT
  DISCOVERY
  VALIDATING
  VALIDATION_REVIEW
  FEASIBILITY_REVIEW
  MVP_PLANNING
  BUILDING
  PILOTING
  LAUNCH_READY
  ACTIVE
  PAUSED
  STOPPED
  ARCHIVED
}

enum VentureMemberRole {
  OWNER
  ADMIN
  EDITOR
  CONTRIBUTOR
  VIEWER
  ADVISOR
}

enum VentureMemberStatus {
  INVITED
  ACTIVE
  DECLINED
  REMOVED
}

enum VentureAssumptionCategory {
  PROBLEM
  CUSTOMER
  MARKET
  WILLINGNESS_TO_PAY
  TECHNICAL
  FINANCIAL
  OPERATIONAL
  DIFFERENTIATION
  TEAM
}

enum VentureRiskLevel {
  LOW
  MEDIUM
  HIGH
}

/// SUPPORTED / REFUTED can only be set by a person and only when recorded evidence exists.
enum VentureAssumptionStatus {
  UNTESTED
  TESTING
  SUPPORTED
  REFUTED
  INCONCLUSIVE
}

enum VentureOrigin {
  USER
  AI_DRAFT
}

enum VentureEvidenceType {
  INTERVIEW
  SURVEY
  EXPERIMENT_RESULT
  OFFICIAL_STATISTIC
  DOCUMENT
  OBSERVATION
  COMPETITOR_RESEARCH
  TEST_ORDER
  OTHER
}

enum VentureEvidenceDirection {
  SUPPORTS
  CONTRADICTS
  NEUTRAL
}

enum VentureVerificationStatus {
  USER_REPORTED
  SOURCE_LINKED
  VERIFIED
  DISPUTED
}

enum VentureExperimentStatus {
  PLANNED
  RUNNING
  COMPLETED
  CANCELLED
}

enum VentureExperimentOutcome {
  SUPPORTS
  CONTRADICTS
  INCONCLUSIVE
}

enum VentureAssessmentKind {
  VENTURE_READINESS
  FUNDING_READINESS
}

enum VentureFeaturePriority {
  MUST
  SHOULD
  COULD
  WONT
}

enum VentureWorkStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum VentureSpecStatus {
  DRAFT
  APPROVED
}

enum VentureScenarioCase {
  CONSERVATIVE
  BASE
  UPSIDE
}

enum VentureLineItemKind {
  STARTUP_COST
  FIXED_COST
  VARIABLE_COST
}

enum VentureKpiMetric {
  LEADS
  ACTIVE_CUSTOMERS
  CUSTOMER_ACQUISITION_COST
  REVENUE
  REPEAT_PURCHASES
  RETENTION_RATE
  GROSS_MARGIN
  MONTHLY_OPERATING_COSTS
  CASH_RUNWAY_MONTHS
  COMPLAINTS
  DELIVERY_TIME_DAYS
}

enum VentureAiKind {
  DISCOVERY
  MVP_SPEC
  ASSESSMENT_EXPLANATION
}

enum VentureAiStatus {
  AI_GENERATED
  TEMPLATE_FALLBACK
  AI_SKIPPED
}

model VentureProject {
  id                  String        @id @default(cuid())
  ownerId             String
  name                String
  ideaSummary         String?       @db.Text
  problemStatement    String?       @db.Text
  sectorId            String?
  districtId          String?
  country             String        @default("RW")
  currency            String        @default("RWF")
  status              VentureStatus @default(DRAFT)
  startMode           String?
  /// The owner must opt in before venture content is sent to an external AI provider.
  aiProcessingConsent Boolean       @default(false)
  launchedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sector   Sector?   @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  members        VentureMember[]
  assumptions    VentureAssumption[]
  sources        VentureResearchSource[]
  evidence       VentureEvidence[]
  segments       VentureCustomerSegment[]
  competitors    VentureCompetitor[]
  experiments    VentureExperiment[]
  assessments    VentureAssessment[]
  businessModels VentureBusinessModel[]
  lineItems      VentureFinancialLineItem[]
  scenarios      VentureFinancialScenario[]
  mvpSpecs       VentureMvpSpecification[]
  features       VentureFeature[]
  milestones     VentureMilestone[]
  activities     VentureActivity[]
  statusChanges  VentureStatusChange[]
  aiExecutions   VentureAiExecution[]
  kpiEntries     VentureKpiEntry[]
  documentLinks  VentureDocumentLink[]

  @@index([ownerId, updatedAt])
  @@index([status])
}

model VentureMember {
  id             String              @id @default(cuid())
  projectId      String
  userId         String
  role           VentureMemberRole
  status         VentureMemberStatus @default(INVITED)
  /// Sections an ADVISOR may read (ignored for other roles).
  sharedSections String[]
  invitedById    String?
  consentedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, status])
}

model VentureAssumption {
  id          String                    @id @default(cuid())
  projectId   String
  statement   String
  category    VentureAssumptionCategory
  riskLevel   VentureRiskLevel          @default(MEDIUM)
  testMethod  String?
  status      VentureAssumptionStatus   @default(UNTESTED)
  origin      VentureOrigin             @default(USER)
  createdById String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  project     VentureProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence    VentureEvidence[]
  experiments VentureExperiment[]

  @@index([projectId, category])
  @@index([projectId, status])
}

/// Publisher and retrieval time are mandatory so every research item is traceable.
model VentureResearchSource {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  publisher   String
  url         String?
  publishedAt DateTime?
  retrievedAt DateTime
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())

  project  VentureProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence VentureEvidence[]

  @@index([projectId])
}

model VentureEvidence {
  id                 String                    @id @default(cuid())
  projectId          String
  assumptionId       String?
  experimentId       String?
  evidenceType       VentureEvidenceType
  direction          VentureEvidenceDirection  @default(NEUTRAL)
  description        String                    @db.Text
  sourceId           String?
  documentId         String?
  respondentLabel    String?
  consentGiven       Boolean                   @default(false)
  consentRecordedAt  DateTime?
  verificationStatus VentureVerificationStatus @default(USER_REPORTED)
  observedAt         DateTime                  @default(now())
  createdById        String?
  createdAt          DateTime                  @default(now())

  project    VentureProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assumption VentureAssumption?     @relation(fields: [assumptionId], references: [id], onDelete: SetNull)
  experiment VentureExperiment?     @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  source     VentureResearchSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([projectId, assumptionId])
  @@index([projectId, evidenceType])
}

model VentureCustomerSegment {
  id                  String   @id @default(cuid())
  projectId           String
  name                String
  description         String?  @db.Text
  size                String?
  needs               String[]
  currentAlternatives String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model VentureCompetitor {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  offering   String?  @db.Text
  priceNote  String?
  strengths  String?
  weaknesses String?
  url        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model VentureExperiment {
  id              String                  @id @default(cuid())
  projectId       String
  assumptionId    String?
  hypothesis      String
  method          String
  targetSample    Int?
  successCriteria String
  startDate       DateTime?
  endDate         DateTime?
  status          VentureExperimentStatus @default(PLANNED)
  createdById     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  project    VentureProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assumption VentureAssumption?        @relation(fields: [assumptionId], references: [id], onDelete: SetNull)
  results    VentureExperimentResult[]
  evidence   VentureEvidence[]

  @@index([projectId, status])
}

model VentureExperimentResult {
  id           String                   @id @default(cuid())
  experimentId String
  observation  String                   @db.Text
  metricName   String?
  metricValue  Float?
  sampleSize   Int?
  outcome      VentureExperimentOutcome
  recordedById String?
  recordedAt   DateTime                 @default(now())

  experiment VentureExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
}

/// Deterministic assessment snapshot. The same inputs and engineVersion always yield the same stored numbers.
model VentureAssessment {
  id                String                @id @default(cuid())
  projectId         String
  kind              VentureAssessmentKind @default(VENTURE_READINESS)
  assessmentVersion Int
  engineVersion     String
  overallScore      Int?
  overallCoverage   Float
  maturityLabel     String
  dimensionScores   Json
  feasibility       Json?
  evidenceCoverage  Json
  missingEvidence   Json
  risks             Json
  recommendations   Json
  inputsDigest      String
  createdById       String?
  createdAt         DateTime              @default(now())

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, assessmentVersion])
}

model VentureBusinessModel {
  id                    String   @id @default(cuid())
  projectId             String
  version               Int
  customerSegments      String[]
  valueProposition      String[]
  channels              String[]
  customerRelationships String[]
  revenueStreams        Json
  keyActivities         String[]
  keyResources          String[]
  keyPartners           String[]
  costStructure         String[]
  notes                 String?  @db.Text
  createdById           String?
  createdAt             DateTime @default(now())

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
}

/// Editable calculation inputs. Scenario rows freeze a copy so results stay reproducible.
model VentureFinancialLineItem {
  id         String              @id @default(cuid())
  projectId  String
  kind       VentureLineItemKind
  label      String
  /// Major currency units (e.g. RWF). STARTUP_COST is one-off, FIXED_COST monthly, VARIABLE_COST per unit sold.
  amount     Decimal             @db.Decimal(18, 2)
  note       String?
  evidenceId String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind])
}

model VentureFinancialScenario {
  id            String              @id @default(cuid())
  projectId     String
  groupId       String
  caseType      VentureScenarioCase
  currency      String
  inputs        Json
  results       Json
  engineVersion String
  createdById   String?
  createdAt     DateTime            @default(now())

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([groupId, caseType])
  @@index([projectId, createdAt])
}

model VentureMvpSpecification {
  id          String            @id @default(cuid())
  projectId   String
  version     Int
  status      VentureSpecStatus @default(DRAFT)
  content     Json
  generatedBy String
  changeNote  String?
  createdById String?
  createdAt   DateTime          @default(now())

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
}

model VentureFeature {
  id                 String                 @id @default(cuid())
  projectId          String
  title              String
  description        String?                @db.Text
  priority           VentureFeaturePriority @default(SHOULD)
  status             VentureWorkStatus      @default(TODO)
  userStory          String?
  acceptanceCriteria String[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, priority])
}

model VentureMilestone {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  status      VentureWorkStatus @default(TODO)
  assigneeId  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model VentureActivity {
  id         String   @id @default(cuid())
  projectId  String
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model VentureStatusChange {
  id          String        @id @default(cuid())
  projectId   String
  fromStatus  VentureStatus
  toStatus    VentureStatus
  changedById String
  reason      String
  evidenceIds String[]
  createdAt   DateTime      @default(now())

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model VentureAiExecution {
  id             String          @id @default(cuid())
  projectId      String
  userId         String
  kind           VentureAiKind
  /// Client-supplied key that makes retries idempotent: the same key returns the stored result and never re-runs.
  idempotencyKey String?
  status         VentureAiStatus
  provider       String?
  model          String?
  schemaValid    Boolean         @default(false)
  input          Json
  output         Json
  createdAt      DateTime        @default(now())

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@index([projectId, kind, createdAt])
}

/// Actual operating results, kept apart from projections (financial scenarios) on purpose.
model VentureKpiEntry {
  id           String           @id @default(cuid())
  projectId    String
  /// Calendar month, YYYY-MM.
  period       String
  metric       VentureKpiMetric
  value        Decimal          @db.Decimal(18, 2)
  note         String?
  recordedById String?
  updatedAt    DateTime         @updatedAt

  project VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, period, metric])
}

/// Links a vault document to a venture. Only metadata is shared; file bytes stay in the owner's vault.
model VentureDocumentLink {
  id         String   @id @default(cuid())
  projectId  String
  documentId String
  label      String
  linkedById String
  createdAt  DateTime @default(now())

  project  VentureProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document ApplicantDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([projectId, documentId])
}
