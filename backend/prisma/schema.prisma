// Single authoritative schema + migration workflow for the whole platform (Prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  STUDENT
  GRADUATE
  JOB_SEEKER
  ENTREPRENEUR
  PROFESSIONAL
  GOVERNMENT_ANALYST
  ADMINISTRATOR
}

enum EducationLevel {
  NONE
  PRIMARY
  LOWER_SECONDARY
  UPPER_SECONDARY
  TVET_CERTIFICATE
  DIPLOMA
  BACHELORS
  MASTERS
  DOCTORATE
}

enum GoalCategory {
  EDUCATION
  CAREER
  ENTREPRENEURSHIP
  SKILLS
  INCOME
  STUDY_ABROAD
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum StepStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

enum StepKind {
  EDUCATION
  SKILL
  EXPERIENCE
  APPLY
  MILESTONE
}

enum RefType {
  PROGRAM
  OPPORTUNITY
  SKILL
  OCCUPATION
}

enum OpportunityType {
  SCHOLARSHIP
  INTERNSHIP
  JOB
  TRAINING
  FELLOWSHIP
  GRANT
}

enum DemandLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
  UNKNOWN
}

enum InstitutionType {
  UNIVERSITY
  POLYTECHNIC
  TVET
  ACADEMY
  OTHER
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum PathType {
  LEARNING_PATH
  CAREER_ROADMAP
}

enum UsageKind {
  AI_REQUEST
  RECOMMENDATION
  ROADMAP
  CHAT
}

enum ChatRole {
  USER
  ASSISTANT
}

// ─────────────────────── Identity & access ───────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          Role     @default(STUDENT)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       Profile?
  goals         Goal[]
  refreshTokens RefreshToken[]
  oneTimeTokens OneTimeToken[]
  chatMessages  ChatMessage[]

  @@index([role])
}

/// Opaque refresh tokens, stored hashed, rotated on every use. `familyId` lets us revoke a whole
/// chain when a rotated token is replayed (token theft detection).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Single-use e-mail verification and password-reset tokens (hash only, never the raw token).
model OneTimeToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  targetId  String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

// ───────────────────── Provenance & national data ─────────────────────

/// Every reference record points to its source. `isDemo` marks illustrative records so they can
/// never be mistaken for official statistics.
model DataSource {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  publisher   String
  url         String?
  license     String?
  publishedAt DateTime?
  retrievedAt DateTime
  notes       String?
  isDemo      Boolean   @default(false)

  districtStats   DistrictStat[]
  indicatorValues IndicatorValue[]
  occupations     Occupation[]
  institutions    Institution[]
  programs        Program[]
  opportunities   Opportunity[]
  careerPaths     CareerPath[]
}

model Province {
  id        String     @id @default(cuid())
  name      String     @unique
  districts District[]
}

model District {
  id         String @id @default(cuid())
  name       String @unique
  provinceId String

  province Province       @relation(fields: [provinceId], references: [id])
  stats    DistrictStat[]
  profiles Profile[]
  institutions Institution[]

  @@index([provinceId])
}

model DistrictStat {
  id              String @id @default(cuid())
  districtId      String
  year            Int
  population      Int
  urbanPopulation Int
  sourceId        String

  district District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  source   DataSource @relation(fields: [sourceId], references: [id])

  @@unique([districtId, year, sourceId])
}

model Indicator {
  id     String @id @default(cuid())
  code   String @unique
  name   String
  unit   String

  values IndicatorValue[]
}

model IndicatorValue {
  id          String @id @default(cuid())
  indicatorId String
  period      String
  geography   String @default("Rwanda")
  value       Float
  sourceId    String

  indicator Indicator  @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  source    DataSource @relation(fields: [sourceId], references: [id])

  @@unique([indicatorId, period, geography])
}

// ───────────────────────── Skills, sectors, occupations ─────────────────────────

model Sector {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  nst2Priority Boolean @default(false)

  occupations Occupation[]
  programs    Program[]
  interests   ProfileSector[]
  careerPaths CareerPath[]
}

model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?

  occupationSkills OccupationSkill[]
  programSkills    ProgramSkill[]
  profileSkills    ProfileSkill[]

  @@index([category])
}

model Occupation {
  id           String         @id @default(cuid())
  title        String         @unique
  description  String?
  sectorId     String
  minEducation EducationLevel @default(UPPER_SECONDARY)
  demand       DemandLevel    @default(UNKNOWN)
  /// Salary fields stay NULL unless a verified figure exists. They are never estimated by the platform.
  salaryMinRwf Int?
  salaryMaxRwf Int?
  sourceId     String?

  sector Sector      @relation(fields: [sectorId], references: [id])
  source DataSource? @relation(fields: [sourceId], references: [id])
  skills OccupationSkill[]
  programs ProgramOccupation[]
  goals  Goal[]
  careerPaths CareerPath[]

  @@index([sectorId])
  @@index([demand])
}

model OccupationSkill {
  occupationId  String
  skillId       String
  importance    Int    @default(3) // 1-5
  requiredLevel Int    @default(3) // 1-5

  occupation Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([occupationId, skillId])
}

// ───────────────────────── Education supply ─────────────────────────

model Institution {
  id         String          @id @default(cuid())
  name       String          @unique
  type       InstitutionType
  districtId String?
  website    String?
  sourceId   String

  district District?  @relation(fields: [districtId], references: [id])
  source   DataSource @relation(fields: [sourceId], references: [id])
  programs Program[]

  @@index([districtId])
}

model Program {
  id             String         @id @default(cuid())
  institutionId  String
  name           String
  level          EducationLevel
  durationMonths Int?
  url            String?
  sectorId       String?
  sourceId       String

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sector      Sector?     @relation(fields: [sectorId], references: [id])
  source      DataSource  @relation(fields: [sourceId], references: [id])
  skills      ProgramSkill[]
  occupations ProgramOccupation[]

  @@unique([institutionId, name])
  @@index([level])
}

model ProgramSkill {
  programId String
  skillId   String

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([programId, skillId])
}

model ProgramOccupation {
  programId    String
  occupationId String

  program    Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  occupation Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  @@id([programId, occupationId])
}

model Opportunity {
  id             String          @id @default(cuid())
  type           OpportunityType
  title          String
  provider       String
  description    String?
  eligibility    String?
  minEducation   EducationLevel?
  deadline       DateTime?
  isRolling      Boolean         @default(false)
  country        String?
  url            String?
  lastVerifiedAt DateTime?
  sourceId       String

  source DataSource @relation(fields: [sourceId], references: [id])

  @@unique([provider, title])
  @@index([type])
  @@index([deadline])
}

/// Reference templates: either a skills learning path or an end-to-end career roadmap for an occupation.
model CareerPath {
  id             String          @id @default(cuid())
  slug           String          @unique
  type           PathType
  title          String
  summary        String
  occupationId   String?
  sectorId       String?
  startLevel     EducationLevel?
  durationMonths Int?
  sourceId       String

  occupation Occupation? @relation(fields: [occupationId], references: [id], onDelete: SetNull)
  sector     Sector?     @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  source     DataSource  @relation(fields: [sourceId], references: [id])
  steps      CareerPathStep[]

  @@index([type])
  @@index([occupationId])
}

model CareerPathStep {
  id            String   @id @default(cuid())
  pathId        String
  order         Int
  phase         String
  title         String
  description   String
  kind          StepKind
  monthOffset   Int      @default(0)
  resourceLabel String?
  resourceUrl   String?

  path CareerPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, order])
}

// ───────────────────────── Monitoring & conversation ─────────────────────────

/// Anonymous operational telemetry (no user id, no content) powering the admin monitoring dashboard.
model UsageEvent {
  id        String    @id @default(cuid())
  kind      UsageKind
  feature   String?
  provider  String?
  success   Boolean   @default(true)
  latencyMs Int?
  errorCode String?
  createdAt DateTime  @default(now())

  @@index([kind, createdAt])
  @@index([provider, createdAt])
}

/// Saved HDOS assistant conversation, owned by the user and deleted with the account.
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      ChatRole
  content   String
  provider  String?
  goalId    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────────── Users' development data ─────────────────────────

model Profile {
  id                     String         @id @default(cuid())
  userId                 String         @unique
  educationLevel         EducationLevel @default(NONE)
  districtId             String?
  birthYear              Int?
  bio                    String?
  targetMonthlyIncomeRwf Int?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  district  District?       @relation(fields: [districtId], references: [id])
  skills    ProfileSkill[]
  interests ProfileSector[]
}

model ProfileSkill {
  profileId String
  skillId   String
  level     Int    @default(1) // 1-5

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
}

model ProfileSector {
  profileId String
  sectorId  String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sector  Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([profileId, sectorId])
}

model Goal {
  id                 String       @id @default(cuid())
  userId             String
  title              String
  description        String?
  category           GoalCategory
  status             GoalStatus   @default(ACTIVE)
  targetDate         DateTime?
  targetOccupationId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetOccupation Occupation? @relation(fields: [targetOccupationId], references: [id], onDelete: SetNull)
  roadmap          Roadmap?

  @@index([userId, status])
}

model Roadmap {
  id            String   @id @default(cuid())
  goalId        String   @unique
  summary       String
  engineVersion String
  generatedAt   DateTime @default(now())

  goal  Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  steps RoadmapStep[]
}

model RoadmapStep {
  id          String     @id @default(cuid())
  roadmapId   String
  order       Int
  phase       String
  title       String
  description String
  kind        StepKind
  monthOffset Int        @default(0)
  status      StepStatus @default(TODO)
  refType     RefType?
  refId       String?
  refLabel    String?
  updatedAt   DateTime   @updatedAt

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, order])
}
