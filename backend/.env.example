# Copy to .env — placeholders only, never commit real secrets.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://hdos:change-me@localhost:5432/hdos_db?schema=public

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Set to true in production. In development a missing SMTP server just logs the link.
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hdos.rw

# Optional. Without a key, /goals/:id/explain returns a deterministic template explanation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=15000

# Privacy: aggregate cells smaller than this are suppressed in government analytics.
ANALYTICS_MIN_COHORT=10
